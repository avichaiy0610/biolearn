generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Topic {
  id                 String     @id @default(cuid())
  slug               String     @unique
  nameHe             String
  nameEn             String
  descHe             String
  descEn             String
  category           String
  icon               String
  reactomePathwayIds String?    // JSON: string[] of pinned Reactome stIds; null = auto-search
  subtopics          Subtopic[]
  processes          Process[]
}

model Subtopic {
  id                 String  @id @default(cuid())
  topicId            String
  topic              Topic   @relation(fields: [topicId], references: [id])
  slug               String
  nameHe             String
  nameEn             String
  contentHe          String
  contentEn          String
  relatedProcessSlug String? // links to a Process.slug for "view animation" button
  hidden             Boolean       @default(false) // hidden from site but visible in admin
  updatedAt          DateTime?     @updatedAt
  reviewedAt         DateTime?     // set when a human checked it against a textbook
  questions          Question[]
  userProgress       UserProgress[]
  quizResults        QuizResult[]
}

model Process {
  id      String        @id @default(cuid())
  topicId String
  topic   Topic         @relation(fields: [topicId], references: [id])
  slug    String
  nameHe  String
  nameEn  String
  descHe  String
  descEn  String
  steps   ProcessStep[]
  updatedAt  DateTime? @updatedAt
  reviewedAt DateTime? // set when a human checked it against a textbook
}

model ProcessStep {
  id        String  @id @default(cuid())
  processId String
  process   Process @relation(fields: [processId], references: [id])
  order     Int
  titleHe   String
  titleEn   String
  descHe    String
  descEn    String
  svgData   String  // JSON-serialized animation data
}

// Durable storage for generated MP4s. Separate table (not a Process column) so
// existing Process queries keep working even before this table is migrated.
// FREE backend (Turso DB) for testing; swap to a paid CDN/blob store later via
// lib/video-storage.ts without touching the rest of the app.
model ProcessVideo {
  slug      String   @id // matches Process.slug
  data      String       // base64-encoded MP4
  createdAt DateTime @default(now())
}

model UploadedMaterial {
  id          String   @id @default(cuid())
  fileName    String
  topicSlug   String?
  rawText     String
  suggestions String   // JSON: array of suggested subtopics
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  hashedPassword String
  name           String?
  createdAt      DateTime       @default(now())
  progress       UserProgress[]
  quizResults    QuizResult[]
  reviews        FlashcardReview[]
  studyDays      StudyDay[]
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId  String
  subtopic    Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  visited     Boolean  @default(true)
  updatedAt   DateTime @updatedAt

  @@unique([userId, subtopicId])
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtopicId String
  subtopic   Subtopic @relation(fields: [subtopicId], references: [id], onDelete: Cascade)
  score      Int      // percentage 0-100
  total      Int
  correct    Int
  type       String   @default("official") // "official" | "ai"
  createdAt  DateTime @default(now())
}

model ChatLog {
  id        String   @id @default(cuid())
  topicSlug String?
  topicName String
  question  String
  createdAt DateTime @default(now())
}

model ContentSuggestion {
  id        String   @id @default(cuid())
  topicSlug String?
  topicName String
  nameHe    String
  nameEn    String
  contentHe String
  contentEn String
  slug      String
  reason    String   // Why the AI suggested this
  priority  Int      @default(0) // Higher = more important
  approved  Boolean  @default(false)
  rejected  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Question {
  id           String   @id @default(cuid())
  subtopicId   String
  subtopic     Subtopic @relation(fields: [subtopicId], references: [id])
  type         String   @default("mcq") // "mcq" | "tf" | "open"
  question     String
  options      String?  // JSON: string[] — only for mcq
  answer       String   // correct answer (option text or "true"/"false")
  explanation  String   // why this is the correct answer
  difficulty   String   @default("medium") // "easy" | "medium" | "hard"
  approved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model ContentFeedback {
  id          String   @id @default(cuid())
  topicSlug   String
  processSlug String?  // set when feedback is on an animation
  subtopicId  String?  // set when feedback is on a subtopic description
  targetType  String   // "animation" | "description" | "diagram"
  comment     String
  status      String   @default("open") // "open" | "resolved"
  createdAt   DateTime @default(now())
}

model Article {
  id           String   @id @default(cuid())
  pubmedId     String?  @unique // null for uploaded PDFs
  title        String
  authors      String   // JSON: string[]
  journal      String?
  year         Int?
  abstract     String
  abstractHe   String?  // AI-translated Hebrew abstract
  keyFindings  String?  // JSON: string[] of key findings in Hebrew
  topicSlugs   String?  // JSON: string[] of related topic slugs
  subtopicIds  String?  // JSON: string[] of related subtopic IDs
  url          String?  // PubMed / DOI link
  source       String   @default("pubmed") // "pubmed" | "upload"
  hidden       Boolean  @default(true) // requires admin approval before publishing
  createdAt    DateTime @default(now())
}

// Past exams uploaded by admins (with permission to publish). The PDF is kept
// in the DB as base64 (≤4 MB, Vercel's request limit) or linked by URL.
model PastExam {
  id          String   @id @default(cuid())
  courseSlug  String   // content/courses.ts slug
  year        Int
  moed        String   // "א" | "ב" | "ג" | "מיוחד"
  university  String?
  notes       String?
  fileName    String?
  fileData    String?  // base64 PDF
  fileSize    Int?
  url         String?
  solutionUrl String?
  createdAt   DateTime @default(now())

  @@index([courseSlug])
}

// Spaced-repetition state per user and glossary card (SM-2 style).
model FlashcardReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId    String   // content/glossary.ts termId(): "<topic>:<en-slug>"
  ease      Float    @default(2.5)
  interval  Int      @default(0)   // days
  reps      Int      @default(0)
  lapses    Int      @default(0)
  due       DateTime
  updatedAt DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId, due])
}

// One row per user per day with any study activity (streaks).
model StudyDay {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // YYYY-MM-DD in Asia/Jerusalem
  actions Int    @default(1)

  @@unique([userId, day])
}
